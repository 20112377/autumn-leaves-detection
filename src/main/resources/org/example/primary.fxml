<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Slider?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController">
   <top>
      <MenuBar prefHeight="30.0" prefWidth="859.0">
         <Menu text="File">
            <MenuItem onAction="#handleOpenImage" text="Open Image..." />
            <SeparatorMenuItem />
            <MenuItem onAction="#handleExit" text="Exit" />
         </Menu>
         <Menu text="Image">
            <MenuItem onAction="#handleOriginal" text="Show Original" />
            <MenuItem onAction="#handleShowBW" text="Show Black and White" />
            <SeparatorMenuItem />
            <MenuItem onAction="#handleAnalyseLeaves" text="Analyse and Count Leaves" />
            <MenuItem onAction="#handleToggleNumbers" text="Toggle Leaf Numbers" />
            <MenuItem onAction="#handleRandomColourAllSets" text="Random Colour All Sets" />
            <SeparatorMenuItem />
            <MenuItem onAction="#handleTSP" text="Animate TSP Path" />
            <SeparatorMenuItem />
            <MenuItem onAction="#handleNoiseSettings" text="Noise Reduction Settings..." />
         </Menu>
      </MenuBar>
   </top>
   <center>
      <StackPane fx:id="imageContainer">
         <ImageView fx:id="imageView" onMouseClicked="#handleImageClick" pickOnBounds="true" preserveRatio="true" />
         <Canvas fx:id="analysisCanvas" mouseTransparent="false" />
      </StackPane>
   </center>
   <left>
      <VBox alignment="TOP_LEFT" prefHeight="500.0" prefWidth="159.0" spacing="10" style="-fx-padding: 10; -fx-border-color: black; -fx-background-color: #DCDCDC;" BorderPane.alignment="CENTER">
         <VBox alignment="TOP_LEFT" prefHeight="137.0" prefWidth="139.0" spacing="10" style="-fx-padding: 10; -fx-border-color: gray;">
            <children>
               <Label style="-fx-font-weight: bold;" text="Image Details" />
               <Label fx:id="filenameLabel" text="Filename: " />
               <Label fx:id="widthLabel" text="Width: " />
               <Label fx:id="heightLabel" text="Height: " />
            </children>
         </VBox>
         <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-border-color: gray; -fx-padding: 10;">
            <children>
               <Label style="-fx-font-weight: bold;" text="Adjust Image" />
               <Label fx:id="hueLabel" text="Hue (-180 to 180)" />
               <Slider fx:id="hueSlider" max="180" min="-180" onMouseDragged="#handleAdjustments" onMouseReleased="#handleAdjustments" value="0" />
               <Label fx:id="satLabel" text="Saturation (0 to 2)" />
               <Slider fx:id="saturationSlider" max="2" min="0" onMouseDragged="#handleAdjustments" onMouseReleased="#handleAdjustments" value="1" />
               <Label fx:id="brightLabel" text="Brightness (0 to 2)" />
               <Slider fx:id="brightnessSlider" max="2" min="0" onMouseDragged="#handleAdjustments" onMouseReleased="#handleAdjustments" value="1" />
               <Label text="Hue Tolerance" />
               <Slider fx:id="toleranceSlider" max="60" min="5" showTickLabels="true" showTickMarks="true" value="20" />
               <Label text="Min Saturation" />
               <Slider fx:id="minSatSlider" max="1" min="0" showTickLabels="true" value="0.15" />
               <Label text="Min Brightness" />
               <Slider fx:id="minBrightSlider" max="1" min="0" showTickLabels="true" value="0.08" />
            </children>
            <HBox alignment="CENTER" spacing="10">
               <Button fx:id="resetButton" onAction="#handleReset" text="Reset" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" >
                  <HBox.margin>
                     <Insets top="10.0" />
                  </HBox.margin>
               </Button>
            </HBox>
         </VBox>
         <VBox spacing="6" style="-fx-padding: 8; -fx-border-color: #aaaaaa; -fx-border-radius: 4; -fx-background-color: white; -fx-background-radius: 4;">
            <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Selected Colours" />
            <FlowPane fx:id="colourSwatchPane" hgap="4" prefWrapLength="150" vgap="4" />
         </VBox>
      </VBox>
   </left>
   <bottom>
      <HBox spacing="10" style="-fx-padding: 5; -fx-background-color: #F0F0F0; -fx-border-color: gray;">
         <Label fx:id="statusLabel" text="Ready" />
      </HBox>
   </bottom>
</BorderPane>
